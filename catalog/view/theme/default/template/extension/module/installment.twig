<style>
.iwc-mod{font-family:inherit;box-sizing:border-box}
.iwc-mod *{box-sizing:border-box}
.iwc-mod-tabs{display:flex;gap:8px;margin-bottom:14px}
.iwc-mod-tab{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;padding:8px 10px;border:1.5px solid #e0e0e0;border-radius:10px;background:#fff;cursor:pointer;min-height:44px;transition:all .15s}
.iwc-mod-tab img{max-height:22px;max-width:80px;object-fit:contain;pointer-events:none}
.iwc-mod-tab>span{font-size:12px;font-weight:600;color:#333;pointer-events:none;white-space:nowrap}
.iwc-mod-tab.active{background:#111;border-color:#111}
.iwc-mod-tab.active img{filter:brightness(0) invert(1)}
.iwc-mod-tab.active>span{color:#fff}
.iwc-mod-tab:hover:not(.active){border-color:#aaa}

.iwc-mod-panel{display:none}
.iwc-mod-panel.active{display:block}

.iwc-mod-section{background:#f5f5f5;border-radius:12px;padding:16px 18px;margin-bottom:10px}
.iwc-mod-slbl{font-size:13px;font-weight:600;color:#222;margin:0 0 12px}

.iwc-mod-months{display:flex;gap:8px;flex-wrap:wrap}
.iwc-mod-m{padding:7px 16px;border:1.5px solid #ddd;border-radius:20px;background:#fff;cursor:pointer;font-size:13px;color:#333;transition:all .15s;white-space:nowrap}
.iwc-mod-m.active{background:#d32f2f;border-color:#d32f2f;color:#fff}
.iwc-mod-m:hover:not(.active){background:#ebebeb;border-color:#ccc}

.iwc-mod-stepper{display:flex;align-items:center;gap:0}
.iwc-mod-sbtn{width:44px;height:44px;border:1.5px solid #ddd;border-radius:8px;background:#fff;cursor:pointer;font-size:24px;line-height:1;display:flex;align-items:center;justify-content:center;color:#444;user-select:none;-webkit-user-select:none;flex-shrink:0}
.iwc-mod-sbtn:hover{background:#e8e8e8}
.iwc-mod-sval{flex:1;text-align:center;font-size:22px;font-weight:500;color:#111}
.iwc-mod-ssym{font-size:20px;color:#c62828;font-weight:600;flex-shrink:0;padding:0 6px 0 2px}

.iwc-mod-res{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;padding:4px 0 8px}
.iwc-mod-ri{display:flex;flex-direction:column;gap:4px}
.iwc-mod-rlbl{font-size:12px;color:#888;font-weight:400}
.iwc-mod-rval{font-size:26px;font-weight:700;color:#111;line-height:1.1}

.iwc-mod-note{font-size:11px;color:#aaa;line-height:1.5;margin:0}
</style>

<div class="iwc-mod" data-price="{{ raw_price }}">

  <div class="iwc-mod-tabs">
    {% for bank in banks %}
    <button class="iwc-mod-tab{% if loop.first %} active{% endif %}" type="button">
      <img src="{{ bank.logo }}" alt="{{ bank.name }}" onerror="this.style.display='none'">
      <span>{{ bank.name }}</span>
    </button>
    {% endfor %}
  </div>

  {% for bank in banks %}
  <div class="iwc-mod-panel{% if loop.first %} active{% endif %}">

    <div class="iwc-mod-section">
      <div class="iwc-mod-slbl">Müddət</div>
      <div class="iwc-mod-months">
        {% for plan in bank.plans %}
        <button class="iwc-mod-m{% if loop.first %} active{% endif %}" data-m="{{ plan.months }}" data-r="{{ plan.rate }}" type="button">{{ plan.months }} ay</button>
        {% endfor %}
      </div>
    </div>

    <div class="iwc-mod-section">
      <div class="iwc-mod-slbl">İlkin ödəniş</div>
      <div class="iwc-mod-stepper">
        <button class="iwc-mod-sbtn iwc-mod-dec" type="button">−</button>
        <span class="iwc-mod-sval">0</span>
        <span class="iwc-mod-ssym">&#8380;</span>
        <button class="iwc-mod-sbtn iwc-mod-inc" type="button">+</button>
      </div>
    </div>

    <div class="iwc-mod-res">
      <div class="iwc-mod-ri">
        <span class="iwc-mod-rlbl">Aylıq ödəniş:</span>
        <strong class="iwc-mod-rval iwc-mod-monthly"></strong>
      </div>
      <div class="iwc-mod-ri" style="text-align:right">
        <span class="iwc-mod-rlbl">Yekun qiymət:</span>
        <strong class="iwc-mod-rval">{{ bank.total }}</strong>
      </div>
    </div>

    <p class="iwc-mod-note">Qeyd: Sifarişin rəsmiləşdirilməsi zamanı 10%-ə qədər xidmət haqqı əlavə oluna bilər</p>

  </div>
  {% endfor %}

</div>

<script>
(function(){
  var w=document.querySelector('.iwc-mod');
  if(!w||w.dataset.iwcMod)return;
  w.dataset.iwcMod='1';
  var price=parseFloat(w.dataset.price)||0;
  var step=Math.max(10,Math.ceil(price/50/10)*10);

  function fmt(n){return n.toFixed(2)+' \u20bc';}

  function calc(panel){
    var init=parseFloat(panel.querySelector('.iwc-mod-sval').textContent)||0;
    var am=panel.querySelector('.iwc-mod-m.active');
    if(!am)return;
    var monthly=Math.max(0,price-init)*(1+parseFloat(am.dataset.r)/100)/parseInt(am.dataset.m);
    panel.querySelector('.iwc-mod-monthly').textContent=fmt(monthly);
  }

  w.querySelectorAll('.iwc-mod-panel').forEach(function(p){calc(p);});

  w.querySelectorAll('.iwc-mod-tab').forEach(function(t,i){
    t.addEventListener('click',function(){
      w.querySelectorAll('.iwc-mod-tab').forEach(function(x){x.classList.remove('active');});
      w.querySelectorAll('.iwc-mod-panel').forEach(function(x){x.classList.remove('active');});
      t.classList.add('active');
      w.querySelectorAll('.iwc-mod-panel')[i].classList.add('active');
    });
  });

  w.querySelectorAll('.iwc-mod-panel').forEach(function(panel){
    panel.querySelectorAll('.iwc-mod-m').forEach(function(b){
      b.addEventListener('click',function(){
        panel.querySelectorAll('.iwc-mod-m').forEach(function(x){x.classList.remove('active');});
        b.classList.add('active');
        calc(panel);
      });
    });
    panel.querySelector('.iwc-mod-inc').addEventListener('click',function(){
      var el=panel.querySelector('.iwc-mod-sval');
      var v=(parseFloat(el.textContent)||0)+step;
      if(v>=price)v=price-step;
      if(v<0)v=0;
      el.textContent=v;
      calc(panel);
    });
    panel.querySelector('.iwc-mod-dec').addEventListener('click',function(){
      var el=panel.querySelector('.iwc-mod-sval');
      var v=(parseFloat(el.textContent)||0)-step;
      if(v<0)v=0;
      el.textContent=v;
      calc(panel);
    });
  });
})();
</script>
